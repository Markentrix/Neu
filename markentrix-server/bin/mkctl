#!/usr/bin/env bash
# mkctl: kleines Werkzeug für den Markentrix-Server.
set -Eeuo pipefail

BASE=/opt/markentrix
SITES=/srv/sites
COMPOSE=(docker compose --project-directory "$BASE" -f "$BASE/docker-compose.yml")

# shellcheck disable=SC1091
set -a; . "$BASE/.env"; set +a
MODE="$(cat "$BASE/mode" 2>/dev/null || echo own)"

die() { printf 'Fehler: %s\n' "$*" >&2; exit 1; }
need_root() { [ "$(id -u)" -eq 0 ] || die "Bitte mit sudo starten."; }

server_ip() { curl -4 -fsS --max-time 5 https://api.ipify.org 2>/dev/null || hostname -I | awk '{print $1}'; }

reload_caddy() {
  if [ "$MODE" = own ]; then
    "${COMPOSE[@]}" exec -T caddy caddy reload --config /etc/caddy/Caddyfile >/dev/null
    echo "Caddy wurde neu geladen."
  else
    echo "Hinweis: Auf diesem Server läuft ein bereits vorhandener Caddy. Er muss die neue Datei noch einbinden:"
    echo "  $BASE/caddy/sites/*.caddy"
  fi
}

write_meta() { # Datei Typ Name Kunde
  printf '{\n  "typ": "%s",\n  "name": "%s",\n  "kunde": "%s",\n  "angelegt": "%s"\n}\n' "$2" "$3" "$4" "$(date +%F)" > "$1/site.json"
}

placeholder_page() { # Zielordner Titel
  cat > "$1/index.html" <<HTML
<!doctype html>
<html lang="de"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>$2</title>
<style>body{margin:0;min-height:100vh;display:grid;place-items:center;font-family:system-ui,sans-serif;background:#0B1020;color:#fff}
main{text-align:center;padding:24px}h1{margin:0 0 8px;font-size:32px}p{margin:0;color:#B8C0DC}</style></head>
<body><main><h1>$2</h1><p>Platzhalter. Hier kommt die Seite hin.</p></main></body></html>
HTML
}

cmd="${1:-help}"; shift || true

case "$cmd" in
  status)
    echo "== Dienste =="
    docker ps --format 'table {{.Names}}\t{{.Status}}' | sort
    echo; echo "== Speicher =="; df -h / "$SITES" 2>/dev/null | awk 'NR==1 || !seen[$1]++'
    echo; echo "== Arbeitsspeicher =="; free -h | awk 'NR<=2'
    echo; echo "== Letzte Sicherung =="
    if [ -f "$BASE/backups/last_success" ]; then date -d "@$(cat "$BASE/backups/last_success")" '+%d.%m.%Y %H:%M'; else echo "noch keine"; fi
    ;;

  backup)
    need_root; "$BASE/bin/backup.sh" ;;

  demo-daten)
    need_root; docker exec mk-portal python -m app.cli demo-daten ;;
  demo-daten-entfernen)
    need_root; docker exec mk-portal python -m app.cli demo-daten-entfernen ;;
  demo-add)
    need_root
    name="${1:-}"; [ -n "$name" ] || die "Aufruf: mkctl demo-add <name> [--from <Ordner>]"
    [[ "$name" =~ ^[a-z0-9]([a-z0-9-]{0,40}[a-z0-9])?$ ]] || die "Name nur mit a-z, 0-9 und Bindestrich."
    dir="$SITES/demos/$name"; [ ! -e "$dir" ] || die "Die Demo $name gibt es schon."
    mkdir -p "$dir"
    if [ "${2:-}" = "--from" ]; then
      [ -d "${3:-}" ] || die "Quellordner nicht gefunden: ${3:-}"
      cp -a "$3"/. "$dir"/
    else
      placeholder_page "$dir" "Demo $name"
    fi
    write_meta "$dir" demo "$name" ""
    chmod -R a+rX "$dir"
    echo "Demo angelegt: https://demo.$DOMAIN/$name/"
    ;;

  site-add)
    need_root
    domain="${1:-}"; [ -n "$domain" ] || die "Aufruf: mkctl site-add <domain> [--from <Ordner>] [--kunde \"Name\"]"
    [[ "$domain" =~ ^([a-z0-9-]+\.)+[a-z]{2,}$ ]] || die "Das sieht nicht wie eine Domain aus: $domain"
    shift
    from=""; kunde=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --from) from="${2:-}"; shift 2 ;;
        --kunde) kunde="${2:-}"; shift 2 ;;
        *) die "Unbekannte Option: $1" ;;
      esac
    done
    dir="$SITES/live/$domain"; [ ! -e "$dir" ] || die "Die Website $domain gibt es schon."
    mkdir -p "$dir" "$BASE/caddy/sites"
    if [ -n "$from" ]; then [ -d "$from" ] || die "Quellordner nicht gefunden: $from"; cp -a "$from"/. "$dir"/; else placeholder_page "$dir" "$domain"; fi
    write_meta "$dir" live "$domain" "$kunde"
    chmod -R a+rX "$dir"
    # Ordner für Wochenangebote: das Portal (Benutzer 10001) darf hier schreiben
    mkdir -p "$dir/angebote/archiv"; chown -R 10001:10001 "$dir/angebote"; chmod -R a+rX "$dir/angebote"
    UPSTREAM="mk-portal:8000"; [ "$MODE" = host ] && UPSTREAM="127.0.0.1:8090"
    cat > "$BASE/caddy/sites/$domain.caddy" <<CADDY
$domain, www.$domain {
	encode zstd gzip
	handle /api/* {
		rewrite * /siteapi{uri}
		reverse_proxy $UPSTREAM
	}
	handle {
		root * /srv/sites/live/$domain
		file_server
	}
}
CADDY
    reload_caddy
    echo "Website angelegt: $domain"
    echo "Damit sie erreichbar ist, muss die Domain per A-Eintrag auf $(server_ip) zeigen (auch www)."
    ;;

  site-list)
    for kind in live demos; do
      echo "== $kind =="
      ls -1 "$SITES/$kind" 2>/dev/null || true
    done
    ;;

  restart)
    need_root; svc="${1:-}"; [ -n "$svc" ] || die "Aufruf: mkctl restart <n8n|panel|portal|caddy|mk-db>"
    "${COMPOSE[@]}" restart "$svc"
    ;;

  admin-add|admin-reset)
    need_root
    [ -n "${1:-}" ] || die "Aufruf: mkctl $cmd <E-Mail>"
    docker exec mk-portal python -m app.cli admin-add "$1" "${2:-}"
    echo "Das Passwort wird nur jetzt angezeigt. Bitte sofort im Passwortmanager speichern."
    ;;

  migrate)
    need_root
    [ -f "$BASE/.env" ] && { set -a; . "$BASE/.env"; set +a; }
    PSQL=(docker exec -i mk-db psql -U markentrix -d markentrix -v ON_ERROR_STOP=1 -q)
    "${PSQL[@]}" -c "CREATE TABLE IF NOT EXISTS schema_migrations (name text PRIMARY KEY, angewendet_am timestamptz NOT NULL DEFAULT now())"
    # Anwendungsrolle (Passwort aus .env), anlegen oder Passwort angleichen
    "${PSQL[@]}" -v pw="$MK_APP_PASSWORD" <<'SQL'
SELECT CASE WHEN EXISTS (SELECT 1 FROM pg_roles WHERE rolname='mk_app')
  THEN format('ALTER ROLE mk_app LOGIN NOSUPERUSER NOBYPASSRLS PASSWORD %L', :'pw')
  ELSE format('CREATE ROLE mk_app LOGIN NOSUPERUSER NOBYPASSRLS PASSWORD %L', :'pw') END \gexec
SQL
    for f in "$BASE"/db/[0-9]*.sql; do
      n="$(basename "$f")"
      if [ "$n" = 999_rechte.sql ]; then
        "${PSQL[@]}" < "$f"   # Rechte immer neu setzen, damit neue Tabellen erfasst werden
        continue
      fi
      done_n="$("${PSQL[@]}" -At -c "SELECT 1 FROM schema_migrations WHERE name='$n'")"
      if [ -z "$done_n" ]; then
        "${PSQL[@]}" < "$f"
        "${PSQL[@]}" -c "INSERT INTO schema_migrations(name) VALUES ('$n')"
        echo "Angewendet: $n"
      else
        echo "Schon vorhanden: $n"
      fi
    done
    ;;

  selbsttest)
    need_root; exec "$BASE/bin/selbsttest.sh" ;;

  psql)
    need_root; docker exec -it mk-db psql -U markentrix -d markentrix
    ;;

  logs)
    svc="${1:-}"; [ -n "$svc" ] || die "Aufruf: mkctl logs <Containername>  (Namen siehe: mkctl status)"
    docker logs --tail 100 -f "$svc"
    ;;

  update)
    need_root
    echo "Vor dem Update läuft eine Sicherung ..."; "$BASE/bin/backup.sh"
    "${COMPOSE[@]}" pull --ignore-buildable n8n n8n-db mk-db
    if [ "$MODE" = own ]; then "${COMPOSE[@]}" pull caddy; "${COMPOSE[@]}" --profile own-caddy up -d --build; else "${COMPOSE[@]}" up -d --build; fi
    "$BASE/bin/mkctl" migrate
    echo "Update fertig."
    ;;

  offsite-setup)
    need_root
    ziel="${1:-}"; [ -n "$ziel" ] || die "Aufruf: mkctl offsite-setup <benutzer@host> [verzeichnis]   (Beispiel: mkctl offsite-setup u123456@u123456.your-storagebox.de markentrix)"
    verz="${2:-markentrix}"
    command -v rsync >/dev/null || { apt-get update -qq && apt-get install -y -qq rsync >/dev/null; }
    install -d -m 700 "$BASE/offsite"
    [ -f "$BASE/offsite/id_ed25519" ] || ssh-keygen -q -t ed25519 -N "" -C "markentrix-backup" -f "$BASE/offsite/id_ed25519"
    [ -f "$BASE/offsite/passphrase" ] || { ( umask 077; openssl rand -hex 24 > "$BASE/offsite/passphrase" ); }
    sed -i '/^OFFSITE_TARGET=/d;/^OFFSITE_PORT=/d' "$BASE/.env"
    printf 'OFFSITE_TARGET=%s:%s/\nOFFSITE_PORT=%s\n' "$ziel" "$verz" "${OFFSITE_PORT:-23}" >> "$BASE/.env"
    echo
    echo "Fast fertig. Zwei Dinge noch:"
    echo
    echo "1) Diesen öffentlichen Schlüssel beim Hetzner Storage Box hinterlegen"
    echo "   (Hetzner Console/Robot -> Storage Box -> SSH-Schlüssel hinzufügen, Port 23 aktivieren):"
    echo
    cat "$BASE/offsite/id_ed25519.pub"
    echo
    echo "2) Dieses Passwort sicher AUSSERHALB des Servers aufbewahren (Passwort-Manager). Ohne es lassen sich die Sicherungen nicht entschlüsseln:"
    echo
    cat "$BASE/offsite/passphrase"
    echo
    echo "Danach prüfen mit:  mkctl offsite-test"
    ;;

  offsite-test)
    need_root
    "$BASE/bin/offsite.sh" --test
    ;;

  restore-test)
    need_root
    "$BASE/bin/restore-test.sh"
    ;;

  alarm-telegram)
    need_root
    tok="${1:-}"; chat="${2:-}"; [ -n "$tok" ] && [ -n "$chat" ] || die "Aufruf: mkctl alarm-telegram <Bot-Token> <Chat-ID>"
    sed -i '/^TELEGRAM_TOKEN=/d;/^TELEGRAM_CHAT=/d' "$BASE/.env"
    printf 'TELEGRAM_TOKEN=%s\nTELEGRAM_CHAT=%s\n' "$tok" "$chat" >> "$BASE/.env"
    "$BASE/bin/watchdog.sh" --test
    ;;

  watchdog)
    need_root; "$BASE/bin/watchdog.sh" "$@" ;;

  n8n-version)
    need_root
    v="${1:-}"; [[ "$v" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || die "Aufruf: mkctl n8n-version <x.y.z>   (aktuell: $(grep '^N8N_VERSION=' "$BASE/.env" | cut -d= -f2))"
    echo "Sicherung vor der Änderung ..."; "$BASE/bin/backup.sh"
    sed -i '/^N8N_VERSION=/d' "$BASE/.env"; echo "N8N_VERSION=$v" >> "$BASE/.env"
    "${COMPOSE[@]}" pull n8n && "${COMPOSE[@]}" up -d n8n
    echo "n8n läuft jetzt mit Version $v. Bitte einmal die Workflows prüfen."
    ;;

  ssh-haerten)
    need_root
    f=/etc/ssh/sshd_config.d/99-markentrix.conf
    if [ "${1:-}" = "--rueckgaengig" ]; then rm -f "$f"; systemctl reload ssh 2>/dev/null || systemctl reload sshd; echo "Rückgängig gemacht."; exit 0; fi
    [ -s /root/.ssh/authorized_keys ] || die "Es ist kein SSH-Schlüssel für root hinterlegt (/root/.ssh/authorized_keys ist leer). Ohne Schlüssel würdest du dich aussperren. Es wurde nichts verändert."
    echo "Das schaltet die Anmeldung per Passwort über SSH ab. Nur noch Schlüssel funktionieren (die Hetzner-Konsole im Browser bleibt davon unberührt)."
    read -r -p "Ist ein Schlüssel hinterlegt UND hast du dich damit schon einmal erfolgreich angemeldet? (ja/nein): " a
    [ "$a" = ja ] || die "Abgebrochen. Es wurde nichts verändert."
    install -d /etc/ssh/sshd_config.d
    printf 'PasswordAuthentication no\nKbdInteractiveAuthentication no\nPermitRootLogin prohibit-password\n' > "$f"
    if sshd -t; then systemctl reload ssh 2>/dev/null || systemctl reload sshd; echo "Fertig. Teste in einem zweiten Fenster, ob die Anmeldung mit Schlüssel noch klappt. Rückgängig: mkctl ssh-haerten --rueckgaengig"
    else rm -f "$f"; die "Die SSH-Einstellung war fehlerhaft und wurde nicht übernommen."; fi
    ;;

  mail-check)
    need_root
    command -v dig >/dev/null || { apt-get update -qq && apt-get install -y -qq dnsutils >/dev/null; }
    d="${1:-$DOMAIN}"; sel="${2:-}"
    echo "Prüfung der Mail-Einträge für $d"
    spf="$(dig +short TXT "$d" | tr -d '"' | grep -i '^v=spf1' || true)"
    [ -n "$spf" ] && echo "  OK      SPF:   $spf" || echo "  FEHLT   SPF   (TXT-Eintrag auf $d, beginnt mit v=spf1; erlaubt deinem Mail-Anbieter zu senden)"
    dm="$(dig +short TXT "_dmarc.$d" | tr -d '"' | grep -i '^v=DMARC1' || true)"
    [ -n "$dm" ] && echo "  OK      DMARC: $dm" || echo "  FEHLT   DMARC (TXT-Eintrag auf _dmarc.$d, z. B. v=DMARC1; p=none; rua=mailto:info@$d)"
    mx="$(dig +short MX "$d" || true)"; [ -n "$mx" ] && echo "  OK      MX:    $(echo "$mx" | tr '\n' ' ')" || echo "  FEHLT   MX    (damit Antworten bei dir ankommen)"
    gefunden=""
    for s in ${sel:-default mail google selector1 selector2 k1 k2 s1 s2 dkim}; do
      k="$(dig +short TXT "${s}._domainkey.$d" | tr -d '"' | grep -i 'v=DKIM1\|p=' || true)"
      [ -n "$k" ] && { echo "  OK      DKIM:  Selektor $s vorhanden"; gefunden=1; }
    done
    [ -n "$gefunden" ] || echo "  FEHLT   DKIM  (Selektor deines Mail-Anbieters unbekannt: mkctl mail-check $d <selektor>; der Selektor steht in der Anbieter-Verwaltung)"
    echo "Anleitung: docs/MAIL-DNS.md"
    ;;

  help|*)
    cat <<TXT
mkctl status                           Überblick: Dienste, Speicher, letzte Sicherung
mkctl backup                           Sicherung jetzt starten
mkctl demo-add <name> [--from Ordner]  Neue Demo unter https://demo.$DOMAIN/<name>/
mkctl site-add <domain> [--from Ordner] [--kunde "Name"]
                                       Neue Kunden-Website mit eigener Domain
mkctl site-list                        Alle Websites und Demos
mkctl restart <n8n|panel|portal|caddy|mk-db>
mkctl logs <Containername>             Protokoll eines Dienstes ansehen
mkctl update                           Sicherung, dann alle Dienste aktualisieren
mkctl admin-add <E-Mail>               Admin fürs Portal anlegen oder Passwort (und 2FA) zurücksetzen
mkctl psql | migrate                   Datenbank-Konsole | Datenbankstruktur aktualisieren
mkctl offsite-setup <benutzer@host> [verzeichnis]   Sicherung zusätzlich verschlüsselt auf eine Hetzner Storage Box
mkctl offsite-test                     Prüft die externe Sicherung
mkctl demo-daten / demo-daten-entfernen   Beispiel-Kunde, -Leads und -Anfragen zum gefahrlosen Üben anlegen bzw. löschen
mkctl selbsttest                       Prüft nach einem Update, ob Anmeldung, Datenbank, Mail, Website-API, Aufträge und Sicherung arbeiten
mkctl restore-test                     Spielt die letzte Sicherung testweise ein und prüft sie
mkctl alarm-telegram <Token> <Chat-ID> Zweiter Alarmweg per Telegram einrichten
mkctl watchdog [--test]                Überwachung von Hand ausführen
mkctl mail-check [domain] [selektor]   Prüft SPF, DKIM, DMARC und MX der Absender-Domain
mkctl n8n-version <x.y.z>              n8n bewusst auf eine bestimmte Version setzen (mit Sicherung)
mkctl ssh-haerten [--rueckgaengig]     SSH nur noch mit Schlüssel (fragt vorher nach)
TXT
    ;;
esac
