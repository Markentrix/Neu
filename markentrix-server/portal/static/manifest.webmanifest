{
  "id": "/",
  "name": "Markentrix Portal",
  "short_name": "Markentrix",
  "description": "Kundenportal, Admin und Partnerportal von Markentrix",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
