{
  "id": "/",
  "name": "Markentrix Portal",
  "short_name": "Markentrix",
  "description": "Kundenportal, Admin und Partnerportal von Markentrix",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait",
  "background_color": "#F7F4EE",
  "theme_color": "#F7F4EE",
  "lang": "de",
  "dir": "ltr",
  "categories": [
    "business",
    "productivity"
  ],
  "prefers_related_applications": false,
  "icons": [
    {
      "src": "/static/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/static/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/static/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "/teilen",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "dateien",
          "accept": [
            "image/*",
            "application/pdf",
            ".pdf",
            ".docx",
            ".xlsx",
            ".txt",
            ".csv"
          ]
        }
      ]
    }
  }
}
