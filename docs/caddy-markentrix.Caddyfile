# Markentrix · Caddy-Konfiguration für markentrix.de · Stand 15.10.2026
# Ersetzt den bisherigen Site-Block in /etc/caddy/Caddyfile.
# Vor dem Einspielen prüfen: Webroot (root) und PHP-Socket (php_fastcgi).
# Einspielen: sudo caddy validate --config /etc/caddy/Caddyfile && sudo systemctl reload caddy

www.markentrix.de {
	redir https://markentrix.de{uri} permanent
}

markentrix.de {
	root * /srv/sites/markentrix
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=(), interest-cohort=()"
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		Cross-Origin-Opener-Policy same-origin
		Content-Security-Policy "default-src 'self'; script-src 'self' https://www.googletagmanager.com https://*.googletagmanager.com https://tracker.metricool.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.google-analytics.com https://*.googletagmanager.com https://tracker.metricool.com; font-src 'self'; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://tracker.metricool.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
		-Server
	}
	header /assets/* Cache-Control "public, max-age=31536000, immutable"
	header /fonts/* Cache-Control "public, max-age=31536000, immutable"
	header /img/* Cache-Control "public, max-age=2592000"

	# /seite.html dauerhaft auf /seite umleiten
	@html path_regexp html ^/(.+)\.html$
	redir @html /{re.html.1} permanent

	# Adressen der alten Website
	redir "/Markentrix Website.dc.html" / permanent
	redir "/Leistungen-KI-Automatisierung.dc.html" /leistungen/ki-automatisierung permanent
	redir "/Leistungen-Marketing.dc.html" /leistungen/marketing permanent
	redir "/Leistungen-Webdesign.dc.html" /leistungen/webdesign permanent
	redir "/Preise.dc.html" /preise permanent
	redir "/Prozess.dc.html" /prozess permanent
	redir "/Ueber-uns.dc.html" /ueber-uns permanent
	redir "/Referenzen.dc.html" /referenzen permanent
	redir "/FAQ.dc.html" /faq permanent
	redir "/ROI-Rechner.dc.html" /roi-rechner permanent
	redir "/Kontakt.dc.html" /kontakt permanent
	redir "/Impressum.dc.html" /impressum permanent
	redir "/Datenschutz.dc.html" /datenschutz permanent
	redir "/AGB.dc.html" /agb permanent
	redir "/KI-Checkliste Markentrix.dc.html" /ki-checkliste permanent
	redir "/KI-Marketing-Celle.dc.html" /ki-marketing-celle permanent
	redir "/KI-Marketing-Hannover.dc.html" /ki-marketing-hannover permanent
	redir "/KI-Marketing-Braunschweig.dc.html" /ki-marketing-braunschweig permanent
	redir "/KI-Marketing-Gifhorn.dc.html" /ki-marketing-gifhorn permanent

	# Protokoll und Git nie ausliefern
	@deny path /anfragen.log /.git /.git/*
	respond @deny 403

	# Nur der Formular-Endpunkt darf PHP ausführen
	@otherphp {
		path *.php
		not path /api/anfrage.php
	}
	respond @otherphp 404
	php_fastcgi /api/anfrage.php unix//run/php/php8.2-fpm.sock

	# Saubere Adressen ohne .html
	try_files {path} {path}.html {path}/index.html

	handle_errors {
		@404 expression {http.error.status_code} == 404
		rewrite @404 /404.html
		file_server
	}

	file_server
}
