# Konfiguration der Markentrix-Website (statisches dist/). Stand 19.10.2026.
# Neu am 19.10.2026: zweiter Endpunkt /api/check.php (Website-Check) neben /api/anfrage.php.
# Ziel: /opt/neu/server/caddy/snippets/markentrix-site.caddy (ersetzt die Fassung vom 07.10.2026).
# Verwendung in /srv/caddy-sites/markentrix.de.caddy bleibt unverändert:  root * /srv/sites/markentrix  +  import markentrix_site
# Änderungen: Einbettung nur noch für die eigene Domain erlaubt (Live-Miniatur auf der Startseite),
# vollständige Content-Security-Policy aus dem Website-Projekt, Formular-Endpunkt /api/anfrage.php
# an den PHP-Container "php" (docker-compose.yml), Protokolldatei nie ausliefern.
(markentrix_site) {
        encode zstd gzip

        header {
                X-Content-Type-Options "nosniff"
                X-Frame-Options "SAMEORIGIN"
                Referrer-Policy "strict-origin-when-cross-origin"
                Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=(), interest-cohort=()"
                Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
                Cross-Origin-Opener-Policy "same-origin"
                Content-Security-Policy "default-src 'self'; script-src 'self' https://www.googletagmanager.com https://*.googletagmanager.com https://tracker.metricool.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.google-analytics.com https://*.googletagmanager.com https://tracker.metricool.com; font-src 'self'; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://tracker.metricool.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
                -Server
        }

        # Interne Dateien aus dist/ nicht ausliefern
        @hidden path /_headers /_redirects /*.md /.* /404 /404.html /anfragen.log
        handle @hidden {
                error 404
        }

        # Alte Dateipfade -> sprechende URLs (301)
        redir "/Markentrix Website.dc.html" / 301
        redir /Leistungen-KI-Automatisierung.dc.html /leistungen/ki-automatisierung 301
        redir /Leistungen-Marketing.dc.html /leistungen/marketing 301
        redir /Leistungen-Webdesign.dc.html /leistungen/webdesign 301
        redir /Preise.dc.html /preise 301
        redir /Prozess.dc.html /prozess 301
        redir /Ueber-uns.dc.html /ueber-uns 301
        redir /Referenzen.dc.html /referenzen 301
        redir /FAQ.dc.html /faq 301
        redir /ROI-Rechner.dc.html /roi-rechner 301
        redir /Kontakt.dc.html /kontakt 301
        redir /Impressum.dc.html /impressum 301
        redir /Datenschutz.dc.html /datenschutz 301
        redir /AGB.dc.html /agb 301
        redir "/KI-Checkliste Markentrix.dc.html" /ki-checkliste 301
        redir /KI-Marketing-Celle.dc.html /ki-marketing-celle 301
        redir /KI-Marketing-Hannover.dc.html /ki-marketing-hannover 301
        redir /KI-Marketing-Braunschweig.dc.html /ki-marketing-braunschweig 301
        redir /KI-Marketing-Gifhorn.dc.html /ki-marketing-gifhorn 301

        # Ehemaliger Kundenbereich -> externes Portal (wird beim CRM-Umzug angepasst)
        redir /kunden-dashboard https://markentrix.netlify.app/ 301
        redir /Kunden-Dashboard.dc.html https://markentrix.netlify.app/ 301

        # /preise.html -> /preise, /index.html -> /
        redir /index.html / 301
        @dothtml {
                path_regexp dothtml ^/(.+)\.html$
                not path /404.html
        }
        redir @dothtml /{re.dothtml.1} 301

        # Caching
        @longcache path /assets/* /fonts/* /beispiel/*/*.css /beispiel/*/*.js
        header @longcache Cache-Control "public, max-age=31536000, immutable"
        @imgcache path /img/*
        header @imgcache Cache-Control "public, max-age=2592000"

        # PHP-Endpunkte: nur diese beiden Dateien (Formular und Website-Check), alles andere mit .php -> 404
        @otherphp {
                path *.php
                not path /api/anfrage.php /api/check.php
        }
        handle @otherphp {
                error 404
        }
        @phpapi path /api/anfrage.php /api/check.php
        php_fastcgi @phpapi php:9000

        # /preise -> preise.html, /leistungen/webdesign -> leistungen/webdesign.html, /beispiel/x/ -> index.html
        try_files {path} {path}.html {path}/index.html
        file_server

        handle_errors {
                rewrite * /404.html
                file_server
        }
}
