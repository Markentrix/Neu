# ElbDetail – Server-Konfiguration. Kopieren nach .env und ausfüllen. Diese Datei NIE ins Git hochladen.

# Domains (DNS A/AAAA-Einträge müssen auf den Server zeigen)
DOMAIN=www.elbdetail.de
DOMAIN_APEX=elbdetail.de
ACME_EMAIL=info@elbdetail.de

# Verwaltungsportal unter https://www.elbdetail.de/admin
ADMIN_USER=admin
# Hash erzeugen: docker compose run --rm app python3 /app/server/app.py passwort
ADMIN_PASSWORD_HASH=
# Zufallswert erzeugen: openssl rand -hex 32
SECRET_KEY=

# E-Mail-Versand für Benachrichtigungen und Eingangsbestätigungen (Postfach des E-Mail-Anbieters)
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=info@elbdetail.de
NOTIFY_TO=info@elbdetail.de
AUTOREPLY=1

# Datenschutz: Anfragen ohne Auftrag nach X Tagen löschen, Statistik nach X Tagen löschen
RETENTION_DAYS=365
STATS_RETENTION_DAYS=760

# Schutz vor Spam: maximale Anfragen je IP-Adresse in 10 Minuten
RATE_LIMIT_ANFRAGEN=6
