# Caddy: HTTPS (Let's Encrypt automatisch), statische Website, Weiterleitung an den App-Server.
# Es werden keine Zugriffsprotokolle mit IP-Adressen geschrieben.
{
	email {$ACME_EMAIL}
}

{$DOMAIN_APEX} {
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}

	# Dynamische Teile: Formulare, Statistik, Verwaltungsportal, Gutscheine
	@app path /api/* /admin /admin/* /gutschein/* /gutschein-druck.js
	handle @app {
		reverse_proxy app:8080
	}

	handle {
		root * /srv/site/current
		header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; frame-src https://www.google.com; form-action 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'"
		header X-Frame-Options "SAMEORIGIN"

		# CSS/JS werden mit ?v=<hash> eingebunden, Galerie-Bilder tragen einen Hash im Namen
		@assets path /fonts/* /img/* *.css *.js *.woff2
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@icons path *.png *.svg *.webmanifest
		header @icons Cache-Control "public, max-age=604800"
		@pages path / *.html
		header @pages Cache-Control "public, max-age=300, must-revalidate"

		try_files {path} {path}.html {path}/index.html
		file_server
	}

	handle_errors {
		@notfound expression {err.status_code} == 404
		handle @notfound {
			root * /srv/site/current
			rewrite * /404.html
			file_server
		}
	}
}
